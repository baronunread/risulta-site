---
import activitySvg from "lucide-static/icons/activity.svg?raw";
import checkSvg from "lucide-static/icons/check.svg?raw";
import circleDotSvg from "lucide-static/icons/circle-dot.svg?raw";
import copySvg from "lucide-static/icons/copy.svg?raw";
import databaseBackupSvg from "lucide-static/icons/database-backup.svg?raw";
import externalLinkSvg from "lucide-static/icons/external-link.svg?raw";
import fileDownSvg from "lucide-static/icons/file-down.svg?raw";
import gitForkSvg from "lucide-static/icons/git-fork.svg?raw";
import globeSvg from "lucide-static/icons/globe.svg?raw";
import shieldCheckSvg from "lucide-static/icons/shield-check.svg?raw";
import starSvg from "lucide-static/icons/star.svg?raw";
import targetSvg from "lucide-static/icons/target.svg?raw";

import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import Layout from "@/layouts/Layout.astro";

const VERSION = "v0.2.0";
const WIDGET_ORIGIN = import.meta.env.PUBLIC_WIDGET_ORIGIN || "https://stats.brnr.dev";
const WIDGET_SITE = import.meta.env.PUBLIC_WIDGET_SITE || "397f485532e940cad72fc704b2cd78e9";
const INSTALL_COMMAND = "curl -fsSL https://risulta.dev/install.sh | sudo sh";

const features = [
  {
    svg: activitySvg,
    title: "Collector and dashboard",
    description: "Track pageviews, then add dated notes to explain traffic changes.",
  },
  {
    svg: globeSvg,
    title: "Multiple websites",
    description: "Connect each website with a guided setup and its own access controls.",
  },
  {
    svg: shieldCheckSvg,
    title: "Cookie-free visitor counts",
    description: "Count daily visitors without cookies or persistent browser identifiers.",
  },
  {
    svg: targetSvg,
    title: "Goals and funnels",
    description: "Define conversion events and follow drop-off across ordered steps.",
  },
  {
    svg: fileDownSvg,
    title: "Exportable reports",
    description: "Export filtered reports as JSON or CSV.",
  },
  {
    svg: databaseBackupSvg,
    title: "Online backups",
    description: "Create and schedule SQLite backups from the same executable.",
  },
];

---

<Layout>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-8 sm:px-10">
    <a class="flex items-center gap-2 font-semibold" href="/">
      <Logo class="size-5" />
      Risulta
    </a>
    <nav aria-label="Main navigation" class="hidden gap-5 text-sm text-muted-foreground sm:flex">
      <a href="#features">Features</a>
      <a href="#sproutboat">Sproutboat</a>
      <a href="/compare/">Compare</a>
      <a href="#github">GitHub</a>
    </nav>
  </header>
  <main class="mx-auto max-w-6xl px-6 sm:px-10">
    <section aria-labelledby="hero-title" class="py-12 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
        <div class="min-w-0">
          <h1 id="hero-title" class="fade-1 text-[clamp(2.5rem,5vw,4rem)] leading-[1.06] font-medium tracking-[-0.045em]">
            <span class="block">Private analytics.</span>
            <span class="block">One small binary.</span>
          </h1>
          <p class="fade-2 mt-6 max-w-[400px] text-base leading-relaxed text-muted-foreground sm:text-lg">
            Understand your website's traffic. Run it on your own server, with SQLite built in.
          </p>
          <div class="fade-3 mt-8 flex items-center gap-6">
            <Button href="#install" class="h-11 px-5">Get started</Button>
            <a class="inline-flex min-h-11 items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground" href="https://github.com/baronunread/risulta">
              Source code
              <Icon svg={externalLinkSvg} class="size-3.5" />
            </a>
          </div>
        </div>
        <section id="live-traffic" aria-labelledby="live-traffic-title" class="fade-3 min-w-0 lg:justify-self-end lg:w-full lg:max-w-[480px]">
          <h2 id="live-traffic-title" class="mb-4 text-xs font-medium text-muted-foreground">Live traffic on risulta.dev</h2>
          <div class="min-h-[238px]">
            <script is:inline async src={`${WIDGET_ORIGIN}/widget.js`} data-site={WIDGET_SITE} data-size="wide" data-theme="auto"></script>
            <noscript><p class="text-sm text-muted-foreground">Enable JavaScript to view this website's live traffic.</p></noscript>
          </div>
          <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted-foreground">Your traffic, out in the open. Embed a live widget on your website. Choose a compact badge, card, or wide layout from Settings.</p>
        </section>
      </div>
    </section>
    <section class="pb-12 sm:pb-16">
      <figure class="overflow-hidden rounded-xl border bg-card">
        <img
          alt="Risulta dashboard showing visitors, visits, pageviews, and a seven-day traffic chart"
          class="block aspect-[4/3] w-full object-cover object-top sm:aspect-[16/11]"
          width={1280}
          height={1332}
          loading="lazy"
          decoding="async"
          src={`${import.meta.env.BASE_URL}risulta-dashboard.png`}
        />
      </figure>
    </section>
    <section id="features" aria-labelledby="features-title" class="py-16 sm:py-24">
      <h2 id="features-title" class="max-w-lg text-3xl leading-tight font-medium tracking-tight sm:text-4xl">Everything you need to understand your traffic.</h2>
      <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map(({ svg, title, description }) => (
            <div>
              <Icon svg={svg} class="mb-4 size-5 text-muted-foreground" />
              <h3 class="text-base font-medium">{title}</h3>
              <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted-foreground">{description}</p>
            </div>
          ))
        }
      </div>
    </section>
    <section id="sproutboat" aria-labelledby="sproutboat-title" class="border-t py-16 sm:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
        <div>
          <h2 id="sproutboat-title" class="text-3xl leading-tight font-medium tracking-tight sm:text-4xl">Built with Sproutboat.</h2>
          <p class="mt-5 max-w-md leading-relaxed text-muted-foreground">A Workers-style fetch handler, compiled into one native executable. The router, storage, and dashboard ship together.</p>
          <a class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground" href="https://sproutboat.com">
            Explore the toolchain <Icon svg={externalLinkSvg} class="size-3.5" />
          </a>
        </div>
        <div class="min-w-0 rounded-xl bg-muted/40 p-6 sm:p-8">
          <pre class="overflow-x-auto text-sm leading-7 text-muted-foreground"><code><span class="text-foreground">export default</span> {"{"}
  fetch(request) {"{"}
    return routeRequest(request);
  {"}"}
{"}"};</code></pre>
          <p class="mt-6 border-t pt-5 font-mono text-xs text-muted-foreground">sproutboat build --standalone</p>
        </div>
      </div>
    </section>
    <section id="compare" aria-labelledby="compare-title" class="border-t py-16 sm:py-24">
      <h2 id="compare-title" class="text-3xl leading-tight font-medium tracking-tight sm:text-4xl">A small footprint, measured.</h2>
      <p class="mt-5 max-w-lg leading-relaxed text-muted-foreground">Embedded SQLite keeps your data in the same process. We ran Risulta alongside other analytics tools to compare their footprint.</p>
      <dl class="mt-10 grid max-w-lg grid-cols-2 gap-8">
        <div>
          <dt class="text-sm text-muted-foreground">Linux binary</dt>
          <dd class="mt-3 text-5xl font-medium tracking-tight tabular-nums">5.8 <span class="text-lg font-normal text-muted-foreground">MB</span></dd>
        </div>
        <div>
          <dt class="text-sm text-muted-foreground">Peak RAM</dt>
          <dd class="mt-3 text-5xl font-medium tracking-tight tabular-nums">13 <span class="text-lg font-normal text-muted-foreground">MiB</span></dd>
        </div>
      </dl>
      <p class="mt-6 text-xs leading-relaxed text-muted-foreground">Linux x86_64. Peak process RSS during a 15-second pageview run with 25 clients.</p>
      <a class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground" href="/compare/">See the measured comparison <Icon svg={externalLinkSvg} class="size-3.5" /></a>
    </section>
    <section id="install" aria-labelledby="install-title" class="border-t py-16 sm:py-24">
      <div class="max-w-2xl">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <h2 id="install-title" class="text-3xl leading-tight font-medium tracking-tight sm:text-4xl">Run Risulta on your server.</h2>
          <a class="text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground" href={`https://github.com/baronunread/risulta/releases/tag/${VERSION}`}>{VERSION}</a>
        </div>
        <p class="mt-5 leading-relaxed text-muted-foreground">One command on Debian or Ubuntu. The installer verifies the release and sets up the Risulta systemd service.</p>
        <div class="mt-8 flex min-w-0 flex-col gap-4 rounded-xl border bg-muted/30 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
          <code class="min-w-0 overflow-x-auto whitespace-nowrap text-sm">{INSTALL_COMMAND}</code>
          <Button id="copy-install-btn" data-command={INSTALL_COMMAND} class="group/copy h-10 w-full shrink-0 justify-center sm:w-auto" variant="secondary">
            <span class="hidden items-center gap-1.5 group-data-[copied]/copy:flex"><Icon svg={checkSvg} />Copied</span>
            <span class="flex items-center gap-1.5 group-data-[copied]/copy:hidden"><Icon svg={copySvg} />Copy command</span>
          </Button>
        </div>
        <details class="mt-5 text-sm text-muted-foreground">
          <summary class="w-fit cursor-pointer py-2 transition-colors hover:text-foreground">Updating an existing installation</summary>
          <p class="mt-3 leading-relaxed">Run <code class="text-foreground">sudo risulta update</code> for stable releases, or <code class="text-foreground">sudo risulta update --channel nightly</code> to follow nightly builds.</p>
        </details>
      </div>
    </section>
    <section id="github" aria-labelledby="github-title" class="border-t py-16 sm:py-24">
      <h2 id="github-title" class="text-3xl leading-tight font-medium tracking-tight sm:text-4xl">Open source, end to end.</h2>
      <p class="mt-5 max-w-lg leading-relaxed text-muted-foreground">Read the code, follow development, or make it your own. AGPL-3.0 for the server and dashboard; MIT for the tracker.</p>
      <div class="mt-10 grid gap-2 sm:grid-cols-3 sm:gap-8">
        <a class="group flex min-h-16 items-center gap-3 rounded-lg py-3 text-sm transition-colors hover:text-muted-foreground" href="https://github.com/baronunread/risulta">
          <Icon svg={gitForkSvg} class="size-4 text-muted-foreground" />Source code<Icon svg={externalLinkSvg} class="ml-auto size-3.5 text-muted-foreground" />
        </a>
        <a class="group flex min-h-16 items-center gap-3 rounded-lg py-3 text-sm transition-colors hover:text-muted-foreground" href="https://github.com/baronunread/risulta/issues">
          <Icon svg={circleDotSvg} class="size-4 text-muted-foreground" />Issues and roadmap<Icon svg={externalLinkSvg} class="ml-auto size-3.5 text-muted-foreground" />
        </a>
        <a class="group flex min-h-16 items-center gap-3 rounded-lg py-3 text-sm transition-colors hover:text-muted-foreground" href="https://github.com/baronunread/risulta/releases">
          <Icon svg={starSvg} class="size-4 text-muted-foreground" />Releases<Icon svg={externalLinkSvg} class="ml-auto size-3.5 text-muted-foreground" />
        </a>
      </div>
    </section>
  </main>
  <footer class="border-t">
    <div class="mx-auto max-w-6xl px-6 py-5 text-sm text-muted-foreground sm:px-10">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <a class="inline-flex items-center gap-2 font-semibold text-foreground" href="/">
            <Logo class="size-4" />
            Risulta
          </a>
          <span class="text-xs">&copy; 2026 Andrea Bruno</span>
        </div>
        <nav aria-label="Footer navigation" class="flex flex-wrap items-center gap-x-4 gap-y-1 [&_a]:py-1 [&_a]:transition-colors [&_a:hover]:text-foreground">
          <a href="#features">Features</a>
          <a href="/compare/">Compare</a>
          <a href="#github">GitHub</a>
          <a href="https://github.com/baronunread/risulta/issues">Issues</a>
          <a href="https://github.com/baronunread/risulta/releases">Releases</a>
          <span class="text-xs">
            Built with{" "}
            <a class="underline underline-offset-2 hover:text-foreground" href="https://sproutboat.com">Sproutboat</a>
          </span>
        </nav>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const button = document.getElementById("copy-install-btn");

  button?.addEventListener("click", async () => {
    const command = button.dataset.command;
    if (!command) return;

    await navigator.clipboard.writeText(command);
    button.setAttribute("data-copied", "");
    window.setTimeout(() => button.removeAttribute("data-copied"), 2000);
  });
</script>
