---
import activitySvg from "lucide-static/icons/activity.svg?raw";
import checkSvg from "lucide-static/icons/check.svg?raw";
import circleDotSvg from "lucide-static/icons/circle-dot.svg?raw";
import copySvg from "lucide-static/icons/copy.svg?raw";
import databaseBackupSvg from "lucide-static/icons/database-backup.svg?raw";
import externalLinkSvg from "lucide-static/icons/external-link.svg?raw";
import fileDownSvg from "lucide-static/icons/file-down.svg?raw";
import gitForkSvg from "lucide-static/icons/git-fork.svg?raw";
import globeSvg from "lucide-static/icons/globe.svg?raw";
import shieldCheckSvg from "lucide-static/icons/shield-check.svg?raw";
import starSvg from "lucide-static/icons/star.svg?raw";
import targetSvg from "lucide-static/icons/target.svg?raw";

import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import CardHeader from "@/components/CardHeader.astro";
import CardTitle from "@/components/CardTitle.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import Layout from "@/layouts/Layout.astro";

const VERSION = "v0.1.6";
const INSTALL_COMMAND =
  "curl -fsSL https://raw.githubusercontent.com/baronunread/risulta/main/deploy/install.sh | sudo sh";

const sizeComparison = [
  { name: "Risulta", value: "4.6 MB", pct: 4, self: true },
  { name: "GoatCounter", value: "~25 MB", pct: 19 },
  { name: "Plausible CE", value: "~58 MB*", pct: 45 },
  { name: "Umami", value: "~130 MB*", pct: 100 },
];

const benchmarks = [
  {
    value: "4.6 MB",
    label: "About a fifth the size of the next-smallest self-hosted option",
    border: "border-b sm:border-b-0 sm:border-r",
  },
  {
    value: "~5.1 ms",
    label: "Median response time in a local ingest benchmark",
    border: "border-b sm:border-b-0 sm:border-r",
  },
  {
    value: "~100 ms",
    label: "Cold start, only on restart - it runs as a long-lived service",
    border: "",
  },
];

const features = [
  {
    svg: activitySvg,
    title: "Collector and dashboard",
    description: "Track pageviews and review reports from the same small server.",
  },
  {
    svg: globeSvg,
    title: "Multiple websites",
    description: "Give every site its own tracker key, data store, and access rules.",
  },
  {
    svg: shieldCheckSvg,
    title: "Cookie-free visitor counts",
    description: "Anonymous, daily-scoped hashes instead of browser identifiers.",
  },
  {
    svg: targetSvg,
    title: "Goals and funnels",
    description: "Define conversion events and follow drop-off across ordered steps.",
  },
  {
    svg: fileDownSvg,
    title: "Exportable reports",
    description: "Bounded JSON and CSV reports with filters, dimensions, and pagination.",
  },
  {
    svg: databaseBackupSvg,
    title: "Online backups",
    description: "One authenticated call snapshots SQLite with an integrity-checked manifest.",
  },
];

const differences = [
  ["One executable", "Dashboard, collector, and authentication together."],
  ["Embedded SQLite", "No PostgreSQL, ClickHouse, or managed database."],
  ["Small tracker", "A pageview-only script without a product suite."],
];
---

<Layout>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-8 sm:px-10">
    <a class="flex items-center gap-2 font-semibold" href="/">
      <Logo class="size-5" />
      Risulta
    </a>
    <nav aria-label="Main navigation" class="hidden gap-5 text-sm text-muted-foreground sm:flex">
      <a href="#features">Features</a>
      <a href="#sproutboat">Sproutboat</a>
      <a href="#compare">Compare</a>
      <a href="#github">GitHub</a>
    </nav>
  </header>
  <main class="mx-auto max-w-6xl px-6 sm:px-10">
    <section class="relative overflow-hidden py-16 sm:py-20">
      <Logo
        class="pointer-events-none absolute -top-16 -right-24 -z-10 size-[26rem] text-foreground/[0.03] sm:size-[34rem]"
      />
      <div class="grid gap-10 lg:grid-cols-[1.05fr_1fr] lg:items-center">
        <div class="min-w-0">
          <div class="fade-1 flex flex-wrap items-center gap-3 text-sm font-medium text-muted-foreground">
            <span>Self-hosted &middot; Multi-site</span>
            <a
              class="rounded-full border px-2.5 py-1 text-xs text-foreground transition hover:bg-accent"
              href={`https://github.com/baronunread/risulta/releases/tag/${VERSION}`}
            >
              {VERSION}
            </a>
          </div>
          <h1 class="mt-5 text-5xl font-semibold tracking-tight sm:text-6xl">
            The smallest self-hosted analytics you can run.
          </h1>
          <p class="fade-2 mt-6 max-w-md text-lg text-muted-foreground">
            A single 4.6 MB binary, no Docker, no database container, no Node runtime. Just the file and its data
            directory.
          </p>
          <div id="install" class="fade-3 mt-8 rounded-xl border bg-card p-4 shadow-sm">
            <p class="text-sm font-medium">Install or update on Debian or Ubuntu</p>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">
              Downloads and verifies the latest release, then installs or updates the Risulta systemd service. Run
              the same command whenever you want the newest version.
            </p>
            <div
              class="mt-4 flex flex-col gap-3 rounded-lg bg-background p-3 text-foreground sm:flex-row sm:items-center sm:justify-between"
            >
              <code class="min-w-0 overflow-x-auto whitespace-nowrap text-sm">
                {INSTALL_COMMAND}
              </code>
              <Button
                id="copy-install-btn"
                data-command={INSTALL_COMMAND}
                class="group/copy w-full shrink-0 justify-center sm:w-34"
                size="sm"
                variant="secondary"
              >
                <span class="hidden items-center gap-1.5 group-data-[copied]/copy:flex">
                  <Icon svg={checkSvg} />
                  Copied
                </span>
                <span class="flex items-center gap-1.5 group-data-[copied]/copy:hidden">
                  <Icon svg={copySvg} />
                  Copy command
                </span>
              </Button>
            </div>
          </div>
          <div class="fade-3 mt-4 flex flex-wrap items-center gap-4">
            <Button variant="outline" href="https://github.com/baronunread/risulta">
              <Icon svg={externalLinkSvg} />
              Source code
            </Button>
            <p class="text-sm text-muted-foreground">AGPL-3.0 server and dashboard; MIT tracker script.</p>
          </div>
        </div>
        <div class="fade-3 lg:justify-self-end">
          <p class="text-right font-mono leading-none">
            <span class="text-7xl font-bold tracking-tight sm:text-8xl">4.6</span>
            <span class="ml-2 text-2xl font-semibold text-muted-foreground">MB</span>
          </p>
          <div class="mt-7 grid gap-2.5 lg:w-80">
            {
              sizeComparison.map(({ name, value, pct, self }) => (
                <div class="grid grid-cols-[92px_1fr_68px] items-center gap-3">
                  <span class="text-sm text-muted-foreground">{name}</span>
                  <span class="h-1.5 overflow-hidden rounded-full bg-muted">
                    <span
                      class={`block h-full rounded-full ${self ? "bg-foreground" : "bg-foreground/25"}`}
                      style={{ width: `${pct}%` }}
                    />
                  </span>
                  <span class="text-right font-mono text-xs">{value}</span>
                </div>
              ))
            }
          </div>
          <p class="mt-3 text-right text-xs text-muted-foreground/70">*Docker image, before adding a database</p>
        </div>
      </div>
    </section>
    <section class="reveal pb-24">
      <figure class="overflow-hidden rounded-xl border bg-card shadow-xl shadow-black/10">
        <div class="flex items-center gap-1.5 border-b bg-muted px-3 py-2.5">
          <span class="size-2.5 rounded-full bg-foreground/15" />
          <span class="size-2.5 rounded-full bg-foreground/15" />
          <span class="size-2.5 rounded-full bg-foreground/15" />
        </div>
        <img
          alt="Risulta dashboard: seven-day visitor trend, top pages, and traffic sources"
          class="block h-auto w-full"
          width={1600}
          height={1681}
          loading="lazy"
          decoding="async"
          src={`${import.meta.env.BASE_URL}risulta-dashboard.png`}
        />
      </figure>
    </section>
    <section id="sproutboat" class="reveal py-24">
      <div class="grid gap-8 md:grid-cols-[1fr_1fr] md:items-center">
        <div>
          <h2 class="max-w-lg text-4xl font-semibold tracking-tight">Built as a binary using Sproutboat.</h2>
          <p class="mt-4 max-w-lg text-muted-foreground">
            Risulta compiles from a Workers-style <code class="rounded bg-muted px-1.5 py-0.5 text-sm">fetch</code>
            handler straight into one native Linux binary through Porffor and Zig. No Node runtime, no Docker, no
            bundler config ships with it.
          </p>
          <p class="mt-4 max-w-lg text-muted-foreground">
            Sproutboat is the toolchain behind that build. Risulta is the real product proving it holds up: the same
            router, storage, and dashboard you can read end to end, running as one file.
          </p>
          <a
            class="mt-6 inline-flex items-center gap-1 text-sm font-medium underline decoration-muted-foreground/40 underline-offset-4 hover:decoration-foreground"
            href="https://sproutboat.com"
          >
            Read about sproutboat
            <Icon svg={externalLinkSvg} class="size-3.5" />
          </a>
        </div>
        <div class="rounded-xl border bg-card p-6 font-mono text-sm leading-7 text-muted-foreground">
          <p class="text-foreground">src/index.js</p>
          <p class="mt-3"><span class="text-muted-foreground/70">export default</span> {"{"}</p>
          <p class="pl-4">fetch(request) {"{"}</p>
          <p class="pl-8">return routeRequest(request);</p>
          <p class="pl-4">{"}"},</p>
          <p>{"}"};</p>
          <p class="mt-4 text-muted-foreground/70"># sproutboat build --standalone</p>
          <p class="text-foreground">&check; dist/risulta-sprout, one file, no runtime</p>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-1 rounded-xl border bg-card sm:grid-cols-3">
        {
          benchmarks.map(({ value, label, border }) => (
            <div class={`p-6 ${border}`}>
              <p class="font-mono text-3xl font-semibold tracking-tight tabular-nums">{value}</p>
              <p class="mt-2 text-sm text-muted-foreground">{label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-muted-foreground">
        Measured with{" "}
        <a
          class="underline decoration-muted-foreground/40 underline-offset-4 hover:decoration-foreground"
          href="https://github.com/baronunread/risulta/blob/main/bench.mjs"
        >
          bench.mjs
        </a>{" "}
        against a same-machine loopback ingest run, 25 concurrent connections. Numbers move with hardware; the method
        is in the repo.
      </p>
    </section>
    <section id="features" class="reveal py-24">
      <p class="text-sm font-medium text-muted-foreground">Included</p>
      <h2 class="mt-4 max-w-lg text-4xl font-semibold tracking-tight">What ships in the binary</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map(({ svg, title, description }) => (
            <Card>
              <CardHeader class="gap-3 py-5">
                <div class="flex size-9 items-center justify-center rounded-lg border bg-accent">
                  <Icon svg={svg} class="size-4.5" />
                </div>
                <CardTitle class="text-base">{title}</CardTitle>
                <p class="text-sm leading-6 text-muted-foreground">{description}</p>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </section>
    <section id="compare" class="reveal grid gap-6 border-t py-20 md:grid-cols-[1fr_1.5fr]">
      <div>
        <p class="text-sm font-medium text-muted-foreground">The difference</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">No analytics stack to operate.</h2>
        <p class="mt-4 text-muted-foreground">
          Risulta favors a focused executable and local storage over containers, hosted accounts, and a separate
          database service. It's a self-hosted alternative to Plausible, Umami, and GoatCounter.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          differences.map(([title, description]) => (
            <div class="border-t pt-5">
              <h3 class="font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
            </div>
          ))
        }
      </div>
    </section>
    <section class="reveal rounded-2xl border bg-card px-8 py-14 text-center sm:px-16">
      <h2 class="text-4xl font-semibold tracking-tight">Run your own analytics today.</h2>
      <p class="mx-auto mt-3 max-w-md text-muted-foreground">
        One command on a Debian or Ubuntu box, and you have a dashboard with no third party reading your traffic.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <Button href="#install">
          <Icon svg={copySvg} />
          Get the install command
        </Button>
        <Button variant="outline" href="https://github.com/baronunread/risulta">
          <Icon svg={externalLinkSvg} />
          Read the source first
        </Button>
      </div>
    </section>
    <section id="github" class="reveal py-24">
      <p class="text-sm font-medium text-muted-foreground">Open source</p>
      <h2 class="mt-4 max-w-lg text-4xl font-semibold tracking-tight">All of it is open source.</h2>
      <p class="mt-4 max-w-lg text-muted-foreground">
        The server, dashboard, tracker, and installer all live in one public repository under AGPL-3.0 (the tracker
        script is MIT).
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <a
          class="group flex flex-col gap-2 rounded-xl border p-5 transition hover:bg-accent"
          href="https://github.com/baronunread/risulta"
        >
          <Icon svg={gitForkSvg} class="size-4.5 text-muted-foreground" />
          <span class="font-medium">baronunread/risulta</span>
          <span class="text-sm text-muted-foreground">Tiny, privacy-friendly multi-site web analytics in one binary.</span>
        </a>
        <a
          class="group flex flex-col gap-2 rounded-xl border p-5 transition hover:bg-accent"
          href="https://github.com/baronunread/risulta/issues"
        >
          <Icon svg={circleDotSvg} class="size-4.5 text-muted-foreground" />
          <span class="font-medium">Issues and roadmap</span>
          <span class="text-sm text-muted-foreground">What's tracked, what's next, and where to file a bug.</span>
        </a>
        <a
          class="group flex flex-col gap-2 rounded-xl border p-5 transition hover:bg-accent"
          href="https://github.com/baronunread/risulta/releases"
        >
          <Icon svg={starSvg} class="size-4.5 text-muted-foreground" />
          <span class="font-medium">Releases</span>
          <span class="text-sm text-muted-foreground">Checksummed Linux x64 and arm64 binaries, one tag at a time.</span>
        </a>
      </div>
    </section>
  </main>
  <footer
    class="mx-auto flex max-w-6xl flex-col gap-6 border-t px-6 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-10"
  >
    <div>
      <a class="flex items-center gap-2 font-semibold text-foreground" href="/">
        <Logo class="size-4" />
        Risulta
      </a>
      <p class="mt-1">
        Self-hosted web analytics in one binary, grown with{" "}
        <a class="underline underline-offset-2 hover:text-foreground" href="https://sproutboat.com">Sproutboat</a>.
        {VERSION}
      </p>
    </div>
    <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="#features">Features</a>
      <a href="#compare">Compare</a>
      <a href="#github">GitHub</a>
      <a href="https://github.com/baronunread/risulta/issues">Issues</a>
      <a href="https://github.com/baronunread/risulta/releases">Releases</a>
    </nav>
    <span>&copy; 2026 Andrea Bruno</span>
  </footer>
</Layout>

<script>
  const button = document.getElementById("copy-install-btn");

  button?.addEventListener("click", async () => {
    const command = button.dataset.command;
    if (!command) return;

    await navigator.clipboard.writeText(command);
    button.setAttribute("data-copied", "");
    window.setTimeout(() => button.removeAttribute("data-copied"), 2000);
  });
</script>
