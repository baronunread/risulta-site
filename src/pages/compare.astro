---
import externalLinkSvg from "lucide-static/icons/external-link.svg?raw";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import Layout from "@/layouts/Layout.astro";

const products = [
  {
    name: "Risulta",
    release: "2026-10-08 benchmark checkout",
    application: "One native executable",
    storage: "Embedded SQLite",
    deploy: "One file and systemd",
    binary: "5.8 MB on disk, Linux x86_64",
    idle: "9 MiB, test process",
    ram: "13 MiB peak RSS, one 15-second run",
    source: "https://github.com/baronunread/risulta",
  },
  {
    name: "GoatCounter",
    release: "v2.7.0",
    application: "One Go service",
    storage: "SQLite or PostgreSQL",
    deploy: "Binary or Docker",
    binary: "Image: 36.2 MB pulled",
    idle: "Not captured",
    ram: "Not captured",
    source: "https://github.com/arp242/goatcounter",
  },
  {
    name: "Umami",
    release: "v3.4.0",
    application: "Node app and database",
    storage: "PostgreSQL or MySQL",
    deploy: "App container plus database",
    binary: "App image: 1,050.8 MB pulled",
    idle: "202 MiB, app + PostgreSQL",
    ram: "310 MiB peak RSS, one 15-second run",
    source: "https://github.com/umami-software/umami",
  },
  {
    name: "Plausible CE",
    release: "v3.2.1",
    application: "Web app and data services",
    storage: "PostgreSQL and ClickHouse",
    deploy: "Docker Compose stack",
    binary: "Image: 168.5 MB pulled",
    idle: "710 MiB, app + PostgreSQL + ClickHouse",
    ram: "Not captured under load",
    source: "https://github.com/plausible/community-edition",
  },
  {
    name: "Mrkr",
    release: "Hosted product",
    application: "Managed service",
    storage: "Vendor hosted",
    deploy: "Script tag, no self-hosted edition",
    binary: "Not applicable",
    idle: "Not applicable",
    ram: "Not applicable",
    source: "https://mrkr.app/",
  },
];
const capabilities = [
["Cookie-free visitor analytics", "Yes", "Yes", "Yes", "Yes", "Yes by default"],
              ["Multiple websites", "Yes", "Yes", "Yes", "Yes", "Yes"],
              ["Custom events", "Yes", "Yes", "Yes", "Yes", "Yes"],
              ["Goals and conversions", "Goals", "Custom events", "Goals", "Goals", "Goals"],
              ["Funnels and journeys", "Funnels", "No", "Funnels and journeys", "Not confirmed for CE", "Funnels and journeys"],
              ["Campaign attribution", "UTM sources and campaigns", "UTM campaigns", "UTM campaigns", "Campaign reports", "Sources and campaigns"],
              ["CSV or data export", "CSV and JSON reports", "CSV and JSON exports", "Data export", "CSV exports", "On request, self-service planned"],
              ["Session replay and heatmaps", "No", "No", "Yes", "No", "Yes"],
              ["MCP server for analytics assistants", "No", "No", "Yes", "No", "Yes"],
              ["First-party proxy for tracker delivery", "No", "No", "No", "No", "Yes"],
              ["AI crawler analytics", "No", "No", "Not confirmed", "No", "Yes"],
              ["Revenue attribution", "Event values, no revenue report", "No", "Revenue insights", "Not confirmed for CE", "Revenue by source and campaign"],
              ["Core Web Vitals", "No", "No", "Yes", "No", "Yes"],
              ["Cohorts and retention", "No", "No", "Yes", "Not confirmed for CE", "Yes"],
              ["Live visitor view", "Live overview", "Realtime stats", "Realtime reports", "Realtime dashboard", "Live map, refreshes every 5 seconds"]
];

---

<Layout
  title="Self-hosted web analytics comparison | Risulta"
  description="Compare Risulta with GoatCounter, Umami, Plausible Community Edition, and Mrkr on features, deployment stack, and measured memory."
>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-8 sm:px-10">
    <a class="flex items-center gap-2 font-semibold" href="/"><Logo class="size-5" />Risulta</a>
    <nav aria-label="Main navigation" class="hidden gap-5 text-sm text-muted-foreground sm:flex">
      <a href="/#features">Features</a>
      <a href="/#sproutboat">Sproutboat</a>
      <a aria-current="page" class="text-foreground" href="/compare/">Compare</a>
      <a href="/#github">GitHub</a>
    </nav>
  </header>
  <main class="mx-auto max-w-6xl px-6 sm:px-10">
    <section class="py-12 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24">
      <h1 class="max-w-3xl text-[clamp(2.5rem,5vw,4rem)] leading-[1.06] font-medium tracking-[-0.045em]">
        <span class="block">Choose your analytics.</span>
        <span class="block">Know what you run.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">Compare features, deployment, and measured footprint across Risulta, GoatCounter, Umami, Plausible CE, and Mrkr.</p>
    </section>

    <section aria-labelledby="features-title" class="pb-16 sm:pb-24">
      <h2 id="features-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Features side by side.</h2>
      <p class="mt-5 max-w-xl leading-relaxed text-muted-foreground">The core capabilities first. Mrkr is a hosted service; the other tools offer self-hosted editions.</p>
      <p class="mt-5 text-xs text-muted-foreground sm:hidden">Swipe the table to compare all five tools.</p>
      {[
        { title: "Core analytics", rows: capabilities.slice(0, 7), expanded: true },
        { title: "More capabilities", rows: capabilities.slice(7), expanded: false },
      ].map(({title, rows, expanded}) => {
        const Tag = expanded ? "div" : "details";
        return (
          <Tag class="mt-8">
            {!expanded && <summary class="w-fit cursor-pointer py-3 text-sm text-muted-foreground transition-colors hover:text-foreground">{title}</summary>}
            <div class="overflow-x-auto" tabindex="0" role="region" aria-label={title}>
              <table class="w-full min-w-[900px] border-collapse text-left text-sm">
                <caption class="sr-only">{title} across five analytics products</caption>
                <thead class="text-muted-foreground">
                  <tr>
                    {["Capability", "Risulta", "GoatCounter", "Umami", "Plausible CE", "Mrkr"].map((name, index) => <th scope="col" class:list={["px-4 py-5 font-medium", index === 1 && "bg-muted/40 text-foreground"]}>{name}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {rows.map(([capability, ...values]) => (
                    <tr class="border-t align-top">
                      <th scope="row" class="px-4 py-5 font-medium">{capability}</th>
                      {values.map((value, index) => <td class:list={["px-4 py-5 leading-relaxed", index === 0 ? "bg-muted/40 text-foreground" : "text-muted-foreground"]}>{value}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Tag>
        );
      })}
      <p class="mt-6 max-w-2xl text-xs leading-relaxed text-muted-foreground">Feature availability follows product documentation and release pages. Plausible CE differs from the commercial product; edition-specific funnels and revenue reports remain unconfirmed.</p>
      <div class="mt-10 max-w-2xl">
        <h3 class="text-base font-medium">What Risulta doesn't include</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Session replay, heatmaps, an MCP server, first-party proxy delivery, AI crawler analytics, Core Web Vitals, cohorts, and retention reports. Umami and Mrkr offer broader analysis if your workflow needs it.</p>
      </div>
    </section>

    <section aria-labelledby="deployment-title" class="border-t py-16 sm:py-24">
      <h2 id="deployment-title" class="text-3xl font-medium tracking-tight sm:text-4xl">The stack you operate.</h2>
      <p class="mt-5 max-w-xl leading-relaxed text-muted-foreground">Risulta ships as one executable. Other self-hosted tools use a service or a stack. Mrkr runs on its vendor's infrastructure.</p>
      <div class="mt-10">
        {products.map((product) => (
          <article class="grid gap-6 border-b py-8 last:border-b-0 lg:grid-cols-[1fr_2fr] lg:gap-16">
            <div>
              <h3 class="text-lg font-medium"><a class="inline-flex items-center gap-2 transition-colors hover:text-muted-foreground" href={product.source}>{product.name}<Icon svg={externalLinkSvg} class="size-3.5 text-muted-foreground" /></a></h3>
              <p class="mt-2 text-xs text-muted-foreground">{product.release}</p>
              <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{product.application}<br />{product.storage}</p>
            </div>
            <dl class="grid grid-cols-2 gap-x-6 gap-y-6 sm:gap-x-8">
              <div><dt class="text-xs text-muted-foreground">Deployment</dt><dd class="mt-2 text-sm leading-relaxed">{product.deploy}</dd></div>
              <div><dt class="text-xs text-muted-foreground">Artifact size</dt><dd class="mt-2 text-sm leading-relaxed">{product.binary}</dd></div>
              <div><dt class="text-xs text-muted-foreground">Idle RAM</dt><dd class="mt-2 text-sm leading-relaxed">{product.idle}</dd></div>
              <div><dt class="text-xs text-muted-foreground">RAM under load</dt><dd class="mt-2 text-sm leading-relaxed">{product.ram}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <details class="mt-6 max-w-2xl text-sm text-muted-foreground">
        <summary class="w-fit cursor-pointer py-3 transition-colors hover:text-foreground">How we measured</summary>
        <div class="mt-3 space-y-3 leading-relaxed">
          <p>RAM sampled on Ubuntu 26.04 x86_64. Loaded figures use one 15-second run with 25 concurrent clients. Plausible's figure is its idle stack.</p>
          <p>Risulta's artifact is the raw Linux executable. Other artifact figures are local Docker image sizes for the listed releases. Executable and image sizes measure different things.</p>
          <p>These results describe the listed versions and one benchmark run. Missing measurements stay marked as not captured.</p>
        </div>
      </details>
    </section>

    <section aria-labelledby="choice-title" class="border-t py-16 sm:py-24">
      <h2 id="choice-title" class="text-3xl font-medium tracking-tight sm:text-4xl">Find the right fit.</h2>
      <div class="mt-10 grid gap-x-16 gap-y-8 sm:grid-cols-2">
        <div><h3 class="font-medium">Risulta</h3><p class="mt-3 text-sm leading-relaxed text-muted-foreground">Dashboard, collector, and SQLite in one executable. A small service for your own Linux server.</p></div>
        <div><h3 class="font-medium">GoatCounter</h3><p class="mt-3 text-sm leading-relaxed text-muted-foreground">A focused privacy-friendly counter, running as a compact Go service with SQLite or PostgreSQL.</p></div>
        <div><h3 class="font-medium">Plausible CE</h3><p class="mt-3 text-sm leading-relaxed text-muted-foreground">A concise dashboard and campaign reports, with PostgreSQL and ClickHouse in its self-hosted stack.</p></div>
        <div><h3 class="font-medium">Umami</h3><p class="mt-3 text-sm leading-relaxed text-muted-foreground">Broader product analytics, including funnels, journeys, replay, and web vitals. An app plus PostgreSQL or MySQL.</p></div>
        <div><h3 class="font-medium">Mrkr</h3><p class="mt-3 text-sm leading-relaxed text-muted-foreground">Hosted analytics with live activity, replay, and revenue attribution. Its FAQ directs users to request data exports.</p></div>
      </div>
    </section>

    <section class="border-t py-16 sm:py-24">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Run Risulta on your server.</h2>
      <p class="mt-5 text-muted-foreground">One command on Debian or Ubuntu.</p>
      <Button class="mt-8 h-11 px-5" href="/#install">Get started</Button>
    </section>
  </main>
  <footer class="border-t">
    <div class="mx-auto max-w-6xl px-6 py-5 text-sm text-muted-foreground sm:px-10">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <a class="inline-flex items-center gap-2 font-semibold text-foreground" href="/">
            <Logo class="size-4" />
            Risulta
          </a>
          <span class="text-xs">&copy; 2026 Andrea Bruno</span>
        </div>
        <nav aria-label="Footer navigation" class="flex flex-wrap items-center gap-x-4 gap-y-1 [&_a]:py-1 [&_a]:transition-colors [&_a:hover]:text-foreground">
          <a href="/#features">Features</a>
          <a href="/compare/">Compare</a>
          <a href="/#github">GitHub</a>
          <a href="https://github.com/baronunread/risulta/issues">Issues</a>
          <a href="https://github.com/baronunread/risulta/releases">Releases</a>
          <span class="text-xs">
            Built with{" "}
            <a class="underline underline-offset-2 hover:text-foreground" href="https://sproutboat.com">Sproutboat</a>
          </span>
        </nav>
      </div>
    </div>
  </footer>
</Layout>
