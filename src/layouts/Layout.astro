---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const SITE_URL = "https://risulta.dev";
const canonicalPath = Astro.url.pathname === "/" ? "/" : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const isHomePage = canonicalPath === "/";

const {
  title = "Risulta | Self-hosted web analytics in one executable",
  description = "Self-hosted, cookie-free web analytics in one native executable with embedded SQLite and no separate database service.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const preference = localStorage.getItem("theme");
        const theme =
          preference === "light" || preference === "dark"
            ? preference
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.classList.add(theme);
        document.documentElement.style.colorScheme = theme;
      } catch {
        document.documentElement.classList.add("dark");
      }
    </script>
    <style>
      html,
      body {
        background: #fff;
      }
      html.dark,
      html.dark body {
        background: #000;
      }
    </style>
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Risulta" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://risulta.dev/og-v2.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Risulta: private web analytics in one executable" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://risulta.dev/og-v2.png" />
    <meta name="twitter:image:alt" content="Risulta: private web analytics in one executable" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isHomePage && <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Risulta",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Linux",
      url: "https://risulta.dev/",
      description: "Self-hosted, cookie-free web analytics in one native executable with embedded SQLite.",
      license: "https://www.gnu.org/licenses/agpl-3.0.html",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    })} />}
    <script defer is:inline src="https://stats.brnr.dev/js/397f485532e940cad72fc704b2cd78e9.js"></script>
  </head>
  <body>
    <slot />
    <script>
      const STORAGE_KEY = "theme";
      const COLOR_SCHEME_QUERY = "(prefers-color-scheme: dark)";

      function getSystemTheme() {
        return window.matchMedia(COLOR_SCHEME_QUERY).matches ? "dark" : "light";
      }

      function isEditableTarget(target: EventTarget | null) {
        if (!(target instanceof HTMLElement)) return false;
        if (target.isContentEditable) return true;
        return Boolean(target.closest("input, textarea, select, [contenteditable='true']"));
      }

      function applyTheme(theme: "light" | "dark") {
        const root = document.documentElement;
        const style = document.createElement("style");
        style.appendChild(
          document.createTextNode("*,*::before,*::after{-webkit-transition:none!important;transition:none!important}"),
        );
        document.head.appendChild(style);

        root.classList.remove("light", "dark");
        root.classList.add(theme);
        root.style.colorScheme = theme;

        window.getComputedStyle(document.body);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            style.remove();
          });
        });
      }

      window.addEventListener("keydown", (event) => {
        if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
        if (isEditableTarget(event.target)) return;
        if (event.key.toLowerCase() !== "d") return;

        const current = document.documentElement.classList.contains("dark") ? "dark" : "light";
        const next = current === "dark" ? "light" : "dark";
        localStorage.setItem(STORAGE_KEY, next);
        applyTheme(next);
      });

      window.matchMedia(COLOR_SCHEME_QUERY).addEventListener("change", () => {
        const preference = localStorage.getItem(STORAGE_KEY);
        if (preference === "light" || preference === "dark") return;
        applyTheme(getSystemTheme());
      });

      window.addEventListener("storage", (event) => {
        if (event.storageArea !== localStorage || event.key !== STORAGE_KEY) return;
        const theme = event.newValue === "light" || event.newValue === "dark" ? event.newValue : getSystemTheme();
        applyTheme(theme);
      });
    </script>
  </body>
</html>
